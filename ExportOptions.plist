<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Export the .ipa to disk; the workflow uploads it with altool in a
	     separate step so upload failures are reported on their own. -->
	<key>destination</key>
	<string>export</string>

	<key>teamID</key>
	<string>QNQR296DT7</string>

	<!-- Manual signing. Automatic signing cannot work here: with it, `archive`
	     signs for *development* and only `-exportArchive` re-signs for
	     distribution, so the runner would also need a development certificate
	     and a development profile fetched from the provisioning API. Manual
	     signing makes both steps use the distribution identity directly and
	     removes every provisioning-API call from the build. -->
	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<!-- Must match PROVISIONING_PROFILE_SPECIFIER in the Release configs. -->
	<key>provisioningProfiles</key>
	<dict>
		<key>com.max.PeakLog</key>
		<string>PeakLog App Store</string>
		<key>com.max.PeakLog.LiveActivityExtension</key>
		<string>PeakLog Extension App Store</string>
	</dict>

	<key>uploadSymbols</key>
	<true/>

	<!-- Keep the build number the workflow injected via CURRENT_PROJECT_VERSION.
	     Leaving this true lets Xcode rewrite it and breaks the run-number scheme. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
