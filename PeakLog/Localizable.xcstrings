{
  "sourceLanguage" : "en",
  "strings" : {
    "#%lld" : {
      "comment" : "A label at the start of each set row that shows the set number.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "The weight achieved in a personal record (PR) displayed in bold text with a background color. The argument is the string “%.0f” or the string “%.1f”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ km · %lld 分钟 · %lld 条记录" : {
      "comment" : "A label displaying the total distance, duration, and number of running records.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ km · %2$lld 分钟 · %3$lld 条记录"
          }
        }
      }
    },
    "%@%@" : {
      "comment" : "The current weight of a workout item, displayed in bold text with a specific color. The argument is the string “%.0f” or the string “%.1f”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A label displaying the number of repetitions in a set",
      "isCommentAutoGenerated" : true
    },
    "%lld / %lld sets completed" : {
      "comment" : "A label displaying the number of sets completed and the total number of sets.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld / %2$lld sets completed"
          }
        }
      }
    },
    "%lld training days · %lld/%lld planned sets completed" : {
      "comment" : "A description of the number of training days and the number of sets that have been completed out of the total number of sets for the week.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld training days · %2$lld/%3$lld planned sets completed"
          }
        }
      }
    },
    "•" : {
      "comment" : "A period used to separate different pieces of information in a list.",
      "isCommentAutoGenerated" : true
    },
    "×" : {
      "comment" : "A multiplication symbol used in the exercise set view.",
      "isCommentAutoGenerated" : true
    },
