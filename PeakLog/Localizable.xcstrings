{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ %@": {
      "comment": "The weight achieved in a personal record (PR) displayed in bold text with a background color. The argument is the string “%.0f” or the string “%.1f”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "A label showing the exercise's equipment and muscle group.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A label displaying the number of repetitions in a set",
      "isCommentAutoGenerated": true
    },
    "%lld/%lld": {
      "comment": "A label displaying the current and total number of sets.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "+%@": {
      "comment": "A plus sign followed by the weight of an added weight vest/dumbbell/belt, e.g. \"+20kg\"",
      "isCommentAutoGenerated": true
    },
    ".": {
      "comment": "A period.",
      "isCommentAutoGenerated": true
    },
    "Activity ID": {
      "comment": "Identifier of the activity for which the plan set is completed.",
      "isCommentAutoGenerated": true
    },
    "Ask the AI coach in chat to create your weekly plan.": {
      "comment": "A message encouraging the user to create a weekly training plan with the AI coach.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat with your coach to create this week's plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和教练聊聊，生成你的本周计划。"
